# ==============================================================================
# SiteSync Backend - Environment Variables Example
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to .env
# 2. Fill in the actual values for your local environment
# 3. NEVER commit your real .env file to version control
# ==============================================================================

# ── PostgreSQL (Supabase Session Pooler) ──────────────────────────────────────
# Host format: aws-0-<region>.pooler.supabase.com
SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
# Username format: postgres.<project-ref>
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=your_supabase_db_password_here

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a secure 64-character base64 string
# (e.g., using: openssl rand -base64 64)
JWT_SECRET=your_super_secret_jwt_key_here

# ── Email (OTP & Notifications) ───────────────────────────────────────────────
GMAIL_ADDRESS=your.app.email@gmail.com
# Use an App Password, not your standard Gmail account password
GMAIL_APP_PASSWORD=abcd_efgh_ijkl_mnop

# ── Supabase Storage (S3 Compatible Endpoint) ─────────────────────────────────
# Found in: Supabase Dashboard -> Storage -> S3 Access Keys
# Endpoint Format: https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_STORAGE_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3

SUPABASE_STORAGE_ACCESS_KEY=your_s3_access_key
SUPABASE_STORAGE_SECRET_KEY=your_s3_secret_key

# The name of the bucket you created in the Supabase Dashboard
SUPABASE_STORAGE_BUCKET=sitesync-media

# Format: https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
SUPABASE_STORAGE_PUBLIC_BASE_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/sitesync-media